# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Provider: whapi | meta
WHATSAPP_PROVIDER=whapi

# Whapi.cloud (si WHATSAPP_PROVIDER=whapi)
WHAPI_TOKEN=...

# Meta Cloud API (si WHATSAPP_PROVIDER=meta)
# META_ACCESS_TOKEN=...
# META_PHONE_NUMBER_ID=...
# META_VERIFY_TOKEN=conduees-verify

# Servidor
PORT=8000
ENVIRONMENT=development

# Base de datos
DATABASE_URL=sqlite+aiosqlite:///./licenciado.db
# Producción: postgresql+asyncpg://user:pass@host:5432/conduees
